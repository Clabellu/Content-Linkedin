// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ========================================
// ARTICLES - Original fetched articles
// ========================================
model Article {
  id              String   @id @default(cuid())
  title           String
  description     String?
  content         String?
  url             String   @unique
  source          String
  publishedAt     DateTime?
  fetchedAt       DateTime @default(now())

  // Deduplication & Quality
  fingerprint     String   @unique
  status          String   @default("new") // new, processed, rejected, archived
  category        String?  // marketing, ai, tech
  qualityScore    Int      @default(0)     // 0-10
  scoreBreakdown  String?  // JSON with score details

  createdAt       DateTime @default(now())

  // Relations
  generatedContents GeneratedContent[]

  @@index([status])
  @@index([qualityScore])
  @@index([category])
}

// ========================================
// GENERATED CONTENTS - AI-generated posts
// ========================================
model GeneratedContent {
  id              String   @id @default(cuid())
  articleId       String

  // Generated content
  linkedinText    String
  imageUrl        String?
  imagePrompt     String?  // Prompt generated by Claude for image

  // Metadata
  generationModel String   @default("claude-sonnet-4-5")
  tone            String   @default("professional") // professional, casual, inspirational
  status          String   @default("draft") // draft, approved, scheduled, published

  // Manual edits
  editedText      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  schedules       Schedule[]

  @@index([status])
  @@index([articleId])
}

// ========================================
// SCHEDULES - Calendar for publishing
// ========================================
model Schedule {
  id              String   @id @default(cuid())
  contentId       String

  scheduledDate   DateTime
  scheduledTime   String   @default("09:00:00")
  dayOfWeek       Int?     // 0=Sun, 1=Mon, etc
  status          String   @default("scheduled") // scheduled, published, cancelled

  createdAt       DateTime @default(now())

  // Relations
  content         GeneratedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([scheduledDate])
  @@index([status])
}

// ========================================
// FINGERPRINTS - Deduplication tracking
// ========================================
model Fingerprint {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  articleUrl  String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  useCount    Int      @default(1)

  @@index([fingerprint])
}

// ========================================
// SOURCES - RSS/News sources config
// ========================================
model Source {
  id          String   @id @default(cuid())
  name        String
  type        String   // rss, google_news
  url         String   @unique
  category    String?  // ai, marketing, general
  isActive    Boolean  @default(true)
  priority    Int      @default(5) // 1-10, higher = more priority

  createdAt   DateTime @default(now())

  @@index([isActive])
  @@index([category])
}
